*.swo
*~

# Logs and runtime artifacts
logs/
*.log
npm-debug.log*

# Local uploads and temporary storage
backend/uploads/*
!backend/uploads/.gitkeep
tmp/
scratch/

# Trained model artifacts / large files (committed models use versioned paths)
# ml-service/artifacts/*.joblib
ml-service/artifacts/*.pkl
!ml-service/artifacts/.gitkeep
!ml-service/artifacts/*.joblib
