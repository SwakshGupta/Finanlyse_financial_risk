# ==============================================================================
# AI-Powered Financial Inclusion: Dynamic Risk Assessment Platform
# Environment Configuration Template (.env.example)
#
# Copy this file to .env before starting the services:
#   cp .env.example .env
# Never commit the actual .env file or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration (Node.js / Express)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finalyse_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finalyse_db

# ------------------------------------------------------------------------------
# Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# Minimum 32-character secret for signing JWT tokens
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# Internal ML Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=dev_internal_ml_service_key_secret

# ------------------------------------------------------------------------------
# Provider-Agnostic LLM / Explainability Configuration
# ------------------------------------------------------------------------------
# Supported providers: gemini | mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
PROMPT_VERSION=risk-explanation-v1

# ------------------------------------------------------------------------------
# File Storage Configuration (Local MVP / AWS S3 Production)
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
# AWS_S3_BUCKET_NAME=finalyse-documents-dev
# AWS_REGION=ap-south-1
